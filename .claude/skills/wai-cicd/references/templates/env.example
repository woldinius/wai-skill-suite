# TEMPLATE — to .env.example in the repo (commit). Real values NEVER belong here,
# but in the server .env (root-only) or GitHub Actions secrets.

# ── Runtime (server .env) ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgres://USER:PASSWORD@db:5432/DBNAME
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# AI provider — server-side, never in the client (secrets management). Prefer the latest Claude models.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Caddy
DOMAIN=api.example.com

# ── GitHub Actions secrets only (NOT in server .env) ────────────────────────────────
# SSH_HOST=            # deploy target
# SSH_USER=deploy
# SSH_KEY=             # private deploy key
# SSH_PORT=22
